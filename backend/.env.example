# MoodTunes AI – Environment Variables
# Copy this to .env and fill in your Groq API key
# Get a free key at: https://console.groq.com

GROQ_API_KEY= YOUR_API_KEY

# Groq model to use (free tier available)
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama3.2:latest

# Local embedding model (runs on CPU, no API key needed)
# Downloads ~90MB on first run
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB storage path (local directory, no server needed)
CHROMA_PATH=./data/chromadb

# SQLite database path
DB_PATH=./data/moodtunes.db

# Server settings
HOST=0.0.0.0
PORT=8000
