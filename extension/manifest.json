{
  "manifest_version": 3,
  "name": "MoodTunes AI",
  "version": "1.0.0",
  "description": "Your AI-powered personal DJ that understands your mood from conversations",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*",
        "https://app.slack.com/*",
        "https://mail.google.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.facebook.com/*",
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content/content-main.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MoodTunes AI"
  },
  "options_ui": {
    "page": "options/settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
